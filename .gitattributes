# 自动检测文本文件
* text=auto

# 仓库配置与文档统一使用 LF
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary

# archived/ 中的历史文本保持原样，确保与上游逐字节一致
archived/*.md -text
archived/COPYING.ARCHIVED -text
